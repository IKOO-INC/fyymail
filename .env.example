# ============================================================
# Fyymotion Auth — Environment Variables
# Copy file ini jadi .env.local untuk development lokal,
# dan isi juga di Vercel Dashboard > Project > Settings > Environment Variables
# ============================================================

# --- SMTP (WAJIB untuk kirim email) ---
# API ini TANPA akun user (tidak ada daftar/login) — cukup API key.
# Tapi SMTP tetap butuh akun provider (Gmail/Brevo/Resend) untuk login & kirim.
# SMTP_FROM harus format VALID: "Nama <local@domain.tld>" — domain wajib ada TLD!
# SALAH: fyymotion@noreply (domain "noreply" tidak valid) → DIBLOKIR Mailjet!
# BENAR: noreply@fyymotion.com atau noreply@domainkamu.com
# ⚠️  MAILJET WAJIB VALIDASI SENDER: buka https://app.mailjet.com/account/sender
#     tambah sender, klik link validasi di email, max 3 hari! Lihat docs/WEBHOOK_MAILJET.md
# Kalau provider menolak From belum terverifikasi, ganti ke alamat terverifikasi.
# Contoh Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=emailkamu@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx   <- App Password Gmail (bukan password biasa!)
# SMTP_FROM="Fyymotion <noreply@fyymotion.com>"
#
# Contoh Brevo (disarankan untuk production, gratis 300 email/hari):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=xxxx@smtp-brevo.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# SMTP_FROM="Fyymotion <noreply@fyymotion.com>"
#
# Contoh Resend:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxxxxx
# SMTP_FROM="Fyymotion <noreply@fyymotion.com>"
#
# Contoh Mailgun / Outlook / SMTP custom lainnya: sesuaikan host & port-nya.
# Port 465 = SSL (SMTP_SECURE=true), Port 587/25 = STARTTLS (SMTP_SECURE=false)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=isi-email-smtp-kamu@gmail.com
SMTP_PASS=isi-app-password-16-karakter
SMTP_FROM="Fyymotion <noreply@fyymotion.com>"

# --- API KEY (WAJIB) ---
# Satu atau banyak, pisahkan koma. Website lain wajib kirim header: x-api-key: <key>
# Generate key acak panjang, contoh: openssl rand -hex 32
API_KEYS=ganti-dengan-key-acak-panjang-min-32-karakter

# --- CORS ---
# Domain website lain yang boleh memanggil API dari browser.
# Untuk keamanan, JANGAN pakai * di production. Contoh:
# ALLOWED_ORIGINS=https://website-a.com,https://website-b.com
# Kalau dipanggil server-to-server (backend ke backend), CORS tidak berpengaruh.
ALLOWED_ORIGINS=*

# --- OTP ---
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
# Hanya untuk testing lokal! Jangan aktifkan di production.
# Kalau true, OTP asli ikut dikembalikan di response (untuk debug).
ALLOW_OTP_IN_RESPONSE=false

# --- Rate Limit ---
# Maksimal request send-otp per email dalam jendela waktu (detik)
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=600

# --- SMTP via Mailjet (OPSIONAL, kalau pakai Mailjet sebagai SMTP) ---
# Host Mailjet: in-v3.mailjet.com, Port 587 (STARTTLS) atau 465 (SSL)
# Dapatkan API Key & Secret di: https://app.mailjet.com/account/apikeys
# SMTP_HOST=in-v3.mailjet.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  <- Mailjet API Key
# SMTP_PASS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  <- Mailjet Secret Key
# SMTP_FROM="Fyymotion <noreply@fyymotion.com>"

# --- Mailjet Webhook (OPSIONAL, untuk tracking event email) ---
# Webhook URL kamu (sudah live): https://auth-fyymotion.vercel.app/api/webhooks/mailjet
# Pasang di Mailjet: Account > Account settings > Event tracking (Triggers)
# Docs: https://dev.mailjet.com/docs/email-api/webhooks/webhooks-overview
#
# Keamanan webhook (pilih salah satu, atau kosongkan untuk izinkan semua):
# Opsi A - Token (paling gampang): set token acak, nanti di Mailjet tambahkan ?token=xxx di URL atau header x-mailjet-token
# MAILJET_WEBHOOK_TOKEN=ganti-dengan-token-acak-panjang
# Opsi B - Basic Auth: Mailjet support URL https://user:pass@auth-fyymotion.vercel.app/api/webhooks/mailjet
# MAILJET_WEBHOOK_USER=user-webhook-kamu
# MAILJET_WEBHOOK_PASS=pass-webhook-kamu-panjang
#
# Forward event ke backend utama kamu (opsional):
# WEBHOOK_FORWARD_URL=https://website-utama-kamu.com/api/mailjet-events

# --- Redis (OPSIONAL, disarankan untuk production) ---
# Dipakai untuk menyimpan hash OTP agar /api/verify-otp konsisten
# di semua instance serverless Vercel. Tanpa ini, OTP disimpan di memory
# dan bisa hilang kalau instance berganti (hanya untuk demo/testing).
# Kalau Redis ada, webhook Mailjet juga otomatis disimpan 7 hari untuk audit.
# Pakai Upstash Redis gratis: https://upstash.com
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxx
